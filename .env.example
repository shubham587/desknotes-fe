# Backend base URL.
# Leave EMPTY in local dev — the Vite dev server proxies /api and /media to
# http://127.0.0.1:8000 (see vite.config.js).
# In production (Vercel), set this to your backend's public URL, e.g.
#   VITE_API_URL=https://your-ngrok-subdomain.ngrok-free.app
# and change it later when the backend moves to Render/Railway.
VITE_API_URL=
